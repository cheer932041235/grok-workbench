{
  "name": "grok-workbench",
  "version": "0.2.1",
  "description": "Desktop visual workspace for Grok Build",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run src/grok/",
    "test:watch": "vitest",
    "lint": "eslint src/grok/ src/routes/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/grok/ src/routes/",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.grok.json",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:check": "npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "fix": "npm run lint:fix && npm run format && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "verify": "npm run lint && npm run format:check && npm run check && npm test && npm run build && npm run rust:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tauri-apps/cli": "^2.5.0",
    "@types/diff": "^7.0.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "svelte": "^5.53.3",
    "svelte-check": "^4.3.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0",
    "vite": "^6.1.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "diff": "^8.0.3",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.0",
    "katex": "^0.18.7",
    "marked": "^15.0.0"
  },
  "browserslist": [
    "safari >= 16.1",
    "chrome >= 105",
    "edge >= 105"
  ],
  "author": "疏锦行 (cheer932041235)",
  "repository": {
    "type": "git",
    "url": "https://github.com/cheer932041235/grok-workbench.git"
  },
  "homepage": "https://github.com/cheer932041235/grok-workbench",
  "bugs": {
    "url": "https://github.com/cheer932041235/grok-workbench/issues"
  }
}
